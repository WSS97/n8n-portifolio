FROM node:18-alpine

# Instala o n8n globalmente dentro do container
RUN npm install -g n8n

# Cria e define a pasta de dados do n8n
WORKDIR /data

# Define a porta padrão exigida pelo Render
ENV PORT=10000
ENV N8N_PORT=10000

# Executa o n8n usando a sintaxe de vetor direta (sem depender de /bin/sh)
ENTRYPOINT ["n8n", "start"]
